# ============================================
# implicarecivica.ro - Environment Variables
# ============================================
# Copy to .env.local and fill in real values

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Models
ANTHROPIC_API_KEY=sk-ant-...        # chat (Claude Sonnet 5, web_search + web_fetch), intrebari strategice si clasificare emailuri (Claude Haiku 4.5)
# CHAT_MODEL=claude-sonnet-5         # implicit; modelul asistentului 544 (poate fi claude-opus-5)
MISTRAL_API_KEY=your-mistral-key    # Mistral OCR (PDF-urile atasate raspunsurilor)
# ANALYSIS_PROVIDER=anthropic       # clasificarea emailurilor: anthropic (implicit, Claude Haiku 4.5) | mistral (ministral, JSON mode)
# ANALYSIS_MODEL=                   # optional: suprascrie modelul furnizorului (ex. mistral-large-latest); MISTRAL_ANALYSIS_MODEL ramane acceptat pentru mistral
# Baza de cunostinte pentru chat (rag_search) este locala: data/institutii/*.json (nu necesita chei).

# Inbound email (Cloudflare Email Worker -> R2 -> /api/webhooks/cloudflare-email)
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLOUDFLARE_EMAIL_WEBHOOK_SECRET=    # acelasi secret setat in worker (WEBHOOK_SECRET)

# Vercel Cron (daily, notify-deadlines; rutele individuale raman apelabile manual) + protectia /api/emails/process (OBLIGATORIU in productie)
CRON_SECRET=

# Admin dashboard (lista de emailuri separate prin virgula)
ADMIN_EMAILS=

# Resend (trimitere emailuri)
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_EMAIL_DOMAIN=implicarecivica.ro   # si expeditorul digest-ului de termene: notificari@<domeniu> (domeniu verificat in Resend)
NEXT_PUBLIC_CHAT_ENDPOINT=/api/chat-haiku
NEXT_PUBLIC_VERCEL_ENV=development    # in Vercel: production (dezactiveaza bypass-ul de auth din middleware cand Supabase lipseste)
